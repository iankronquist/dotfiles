[user]
email = i_kronquist@apple.com
name = "Ian Kronquist"

[core]
editor = vim
excludesfile = ~/.gitignore
autocrlf = false
eol = lf
sparsecheckout = true

[push]
default = simple

[alias]
net = log --graph --all --decorate
# Stolen from https://github.com/GitAlias/gitalias/blob/master/gitalias.txt
churn = !git log --all -M -C --name-only --format='format:' "$@" | sort | grep -v '^$' | uniq -c | sort
stash-all = stash save --include-untracked
prune = fetch --prune

[color]
ui = auto

[init]
defaultBranch = main

[gpg]
format = x509

#[gpg "x509"]
#program = /usr/local/bin/ac-sign

#[commit]
#gpgsign = true

[review "gerrit.sd.apple.com"]
username = i_kronquist

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg "x509"]
	program = /usr/local/bin/ac-sign
[commit]
	gpgsign = true
[credential]
	helper = cache
[safe]
	directory = /Users/ian/shared/applesepos-pr1
	directory = /Users/ian/shared/applesepos-base
	directory = /Users/ian/shared/sep_firebloom_tools
	directory = /Users/ian/shared/applekeystore-sksfb
	directory = /Users/ian/shared/aneexclave-fb
	directory = /Users/ian/shared/corecrypto
	directory = /Users/ian/shared/applecredentialmanager-fb
	directory = /Users/ian/shared/applesecurenetworkcoprocessor-cpa
	directory = /Users/ian/shared/applesephdcp-fb
	directory = /Users/ian/shared/oysterapp-fb
	directory = /Users/ian/shared/applessma-fb
	directory = /Users/ian/shared/oysterapp-fb
	directory = /Users/ian/shared/applesse-fb
	directory = /Users/ian/shared/applessma-fb
	directory = /Users/ian/shared/oysterapp-fb
	directory = /Users/ian/shared/applesse-fb
	directory = /Users/ian/shared/biometrickit-fb
	directory = /Users/ian/shared/corerepair-fb
	directory = /Users/ian/shared/embeddedfieldrepair-fb
	directory = /Users/ian/shared/applesepos-b2
	directory = /Users/ian/shared/applesepos-b5
	directory = /Users/ian/shared/applessma-fb
	directory = /Users/ian/shared/oysterapp-fb
	directory = /Users/ian/shared/applesse-fb
